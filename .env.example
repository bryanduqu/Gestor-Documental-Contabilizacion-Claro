# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_key
AZURE_DOCUMENT_INTELLIGENCE_CLASSIFIER_ID=your_classifier_id
AZURE_DOCUMENT_INTELLIGENCE_EXTRACTION_MODELS={"Formato de cumplimiento":"your_model_id","Entrada de mercancía":"your_model_id","Orden de compra A":"your_model_id","Orden de compra B":"your_model_id"}

# Backend
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=90

# Frontend
FRONTEND_API_BASE_URL=http://localhost:8000
